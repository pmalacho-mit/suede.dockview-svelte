{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "release",
    "suede.sweater-vest",
    "suede.nests"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig/tsconfig.app.json && tsc -p tsconfig/tsconfig.node.json",
    "report": "node suede.sweater-vest/report/index.ts",
    "copy:style": "mkdir -p dist/styles/ && cp node_modules/dockview/dist/styles/dockview.css dist/styles/"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.10.0",
    "jsdom": "^27.0.0",
    "svelte-check": "^4.3.3",
    "vite": "npm:rolldown-vite@7.2.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.2"
  }
}
